{
  "info": {
    "name": "Devsu Bank - APIs y casos de aceptación",
    "description": "Ejecutar toda la colección con delay de 1000 ms. Los números llevan un prefijo por ejecución para permitir repetición. Scripts smoke.py --demo cargan los números exactos. Fechas UTC, cliente es UUID. PUT/PATCH de movimientos solo corrigen el último y generan auditoría.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "clientsUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "accountsUrl",
      "value": "http://localhost:5002"
    }
  ],
  "item": [
    {
      "name": "01 - Clientes disponible / preparar ejecución",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{clientsUrl}}/health/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('run', Date.now().toString());",
              "pm.collectionVariables.set('movementKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Cuentas disponible",
