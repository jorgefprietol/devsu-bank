          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Jose Lema\",\n  \"genero\": \"No especificado\",\n  \"edad\": 35,\n  \"identificacion\": \"{{run}}jose\",\n  \"direccion\": \"Otavalo sn y principal\",\n  \"telefono\": \"098254785\",\n  \"contrasena\": \"1234\",\n  \"estado\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('joseId', pm.response.json().clienteId);",
              "pm.test('Sin contraseña en respuesta', () => pm.expect(pm.response.json()).not.to.have.property('passwordHash'));"
